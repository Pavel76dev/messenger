# Путь к локальной модели (без скачивания с Hugging Face).
# По умолчанию: models/faster-whisper-small (скопировать скриптом).
WHISPER_MODEL=models/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Обязательно под Apache/OpenServer: служба не видит user PATH (winget).
# FFMPEG_PATH=C:\Users\...\WinGet\Packages\Gyan.FFmpeg_...\ffmpeg-...\bin\ffmpeg.exe
