APP_NAME=Messenger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://messenger

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=messenger
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=messenger,localhost,127.0.0.1,localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://messenger
